# Copy this file to .env and fill in your Stripe Test Mode values.
# NEVER commit real secrets or use sk_live_ keys in development/test.

# PostgreSQL 16 (matches docker-compose.yml defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=saas_example_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Phoenix Endpoint
PORT=4000
PHX_HOST=localhost
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=dev_only_replace_with_64_byte_secret_key_base_generated_by_mix_phx_gen_secret

# Stripe Test Mode credentials (use sk_test_ and whsec_ from `stripe listen`)
STRIPE_API_KEY=sk_test_replace_with_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
# Enforce Stripe Test Mode (reject livemode=true events fail-closed)
STRIPE_EXPECTED_LIVEMODE=false

# Server-controlled Stripe Price IDs (create recurring prices in Stripe Test Mode)
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly
